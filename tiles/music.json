{
  "title": "now playing",
  "accent": "#ff55ff",
  "min": {
    "w": 320,
    "h": 180
  },
  "config": {
    "endpoint": "https://lastfm-last-played.biancarosa.com.br/usr40k/latest-song",
    "workerUrl": "https://lastfm.usr-40476.workers.dev/",
    "pollMs": 45000,
    "fallbackArt": "media/images/cooked.gif"
  },
  "html": [
    "<div class='np'><p class='loading'>last.fm what r u doin :3</p></div>"
  ],
  "css": [
    ".np { display: flex; flex-wrap: nowrap; gap: 16px; align-items: stretch; height: 100%; }",
    ".art { width: clamp(100px, 35%, 150px); aspect-ratio: 1; object-fit: cover; border: 1px solid var(--line); background: var(--bg-alt); flex: none; align-self: flex-start; }",
    ".meta { min-width: 0; flex: 1 1 auto; display: flex; flex-direction: column; height: 100%; }",
    ".track { color: var(--accent); font-weight: 700; overflow-wrap: anywhere; }",
    ".artist { color: var(--dim); overflow-wrap: anywhere; }",
    ".flag { color: var(--dim); font-size: 0.9em; margin-bottom: 4px; }",
    ".flag.live { color: var(--ok); }",
    ".graph-section { margin-top: auto; border-top: 1px dashed var(--line); padding-top: 6px; display: flex; flex-direction: column; flex: 1; min-height: 50px; }",
    ".graph-header { font-size: 0.75em; color: var(--dim); margin-bottom: 2px; display: flex; justify-content: space-between; }",
    ".equalizer { display: flex; align-items: flex-end; gap: 1px; flex: 1; width: 100%; background: var(--bg-alt); padding: 2px; border-radius: 4px; overflow: hidden; }",
    ".eq-bar { flex: 1; background: var(--accent); opacity: 0.75; min-height: 2px; border-top-left-radius: 1px; border-top-right-radius: 1px; transition: opacity 0.15s; }",
    ".eq-bar:hover { opacity: 1; }"
  ],
  "js": [
    "const box = root.querySelector('.np');",
    "const cfg = ctx.config;",
    "const BLANK = '2a96cbd8b46e442fc41c2b86b821562f';",
    "",
    "async function fetchStats() {",
    "  try {",
    "    const res = await fetch(cfg.workerUrl);",
    "    const data = await res.json();",
    "    const scrobbles = data.scrobbles || [];",
    "    ",
    "    const now = Math.floor(Date.now() / 1000);",
    "    const hours = Array.from({ length: 24 }, () => ({ count: 0, songs: [] }));",
    "    ",
    "    scrobbles.forEach(s => {",
    "      const diffSec = now - s.time;",
    "      if (diffSec <= 86400 && diffSec >= 0) {",
    "        const hoursAgo = Math.floor(diffSec / 3600);",
    "        const bucketIndex = 23 - hoursAgo;",
    "        if (bucketIndex >= 0 && bucketIndex < 24) {",
    "          hours[bucketIndex].count++;",
    "          hours[bucketIndex].songs.push(s.title);",
    "        }",
    "      }",
    "    });",
    "    ",
    "    return { count: scrobbles.length, hourly: hours };",
    "  } catch (e) {",
    "    return { count: 0, hourly: Array.from({ length: 24 }, () => ({ count: 0, songs: [] })) };",
    "  }",
    "}",
    "",
    "function getCurvedBars(hourlyData, totalBars = 60) {",
    "  const counts = hourlyData.map(h => h.count);",
    "  const maxVal = Math.max(...counts, 1);",
    "  ",
    "  // Catmull-Rom to Cubic Bézier smoothing or moving average interpolation",
    "  const smoothValues = [];",
    "  for (let i = 0; i < totalBars; i++) {",
    "    const floatIdx = (i / (totalBars - 1)) * (counts.length - 1);",
    "    const baseIdx = Math.floor(floatIdx);",
    "    const frac = floatIdx - baseIdx;",
    "    ",
    "    const p0 = counts[baseIdx === 0 ? 0 : baseIdx - 1];",
    "    const p1 = counts[baseIdx];",
    "    const p2 = counts[baseIdx + 1 < counts.length ? baseIdx + 1 : baseIdx];",
    "    const p3 = counts[baseIdx + 2 < counts.length ? baseIdx + 2 : baseIdx + 1 < counts.length ? baseIdx + 1 : baseIdx];",
    "",
    "    // Smooth interpolation across points",
    "    const val = p1 + 0.5 * frac * (p2 - p0 + frac * (2 * p0 - 5 * p1 + 4 * p2 - p3 + frac * (3 * (p1 - p2) + p3 - p0)));",
    "    smoothValues.push(Math.max(val, 0));",
    "  }",
    "",
    "  const smoothMax = Math.max(...smoothValues, 1);",
    "",
    "  return smoothValues.map((val, i) => {",
    "    const heightPercent = Math.max((val / smoothMax) * 100, 6);",
    "    // Map back approximately to the original hourly bucket for song tooltips",
    "    const originalBucket = Math.min(Math.floor((i / totalBars) * 24), 23);",
    "    const h = hourlyData[originalBucket];",
    "    const tooltipText = h && h.songs.length > 0 ? `${h.count} scrobbles in this window:\\n- ` + h.songs.join('\\n- ') : '0 scrobbles';",
    "    return `<div class='eq-bar' style='height: ${heightPercent}%' title='${ctx.esc(tooltipText)}'></div>`;",
    "  }).join('');",
    "}",
    "",
    "async function render(data) {",
    "  const track = data && data.track;",
    "  if (!track) { box.innerHTML = `<p class='dim'>no scrobble data yet </p>`; return; }",
    "  const imgs = track.image || [];",
    "  const pick = imgs.find((i) => i.size === 'large') || imgs[imgs.length - 1] || {};",
    "  let art = pick['#text'] || '';",
    "  if (art.includes(BLANK)) art = '';",
    "  const live = track['@attr'] && track['@attr'].nowplaying === 'true';",
    "  const artist = (track.artist && track.artist['#text']) || 'unknown artist ಠ_ಠ';",
    "",
    "  const stats = await fetchStats();",
    "  const barsHtml = getCurvedBars(stats.hourly, 64);",
    "",
    "  box.innerHTML = `",
    "    <img class='art' src='${ctx.esc(art || cfg.fallbackArt)}' alt='' loading='lazy'>",
    "    <div class='meta'>",
    "      <div class='track'>${ctx.esc(track.name || 'unknown track ಠ_ಠ')}</div>",
    "      <div class='artist'>${ctx.esc(artist)}</div>",
    "      <div class='flag ${live ? 'live' : ''}'>${live ? '● right now :3' : '○ last played (ZzZ)'}</div>",
    "      <div class='graph-section'>",
    "        <div class='graph-header'><span>past 24h</span><span><b>${stats.count}</b> total</span></div>",
    "        <div class='equalizer'>${barsHtml}</div>",
    "      </div>",
    "    </div>`;",
    "}",
    "",
    "async function poll() {",
    "  try {",
    "    const r = await fetch(cfg.endpoint);",
    "    render(r.ok ? await r.json() : null);",
    "  } catch (e) {",
    "    box.innerHTML = `<p class='dim'>last.fm is ded or ur cooked</p>`;",
    "  }",
    "}",
    "",
    "poll();",
    "ctx.interval(poll, cfg.pollMs || 45000);"
  ]
}
