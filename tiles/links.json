  "accent": "#ffff55",
  "min": {
    "w": 176,
    "h": 120
  },
  "config": {
    "links": [
      {
        "label": "Matrix",
        "text": "@usr40k:usr40k.dev",
        "href": "https://matrix.to/#/@usr40k:usr40k.dev"
      },
      {
        "label": "PIXIV",
        "text": "usr40k",
