{
  "title": "projects",
  "accent": "#00ffff",
  "min": {
    "w": 240,
    "h": 140
  },
  "config": {
    "count": 6,
    "cacheMinutes": 10
  },
  "html": [
    "<h2><span data-user>usr40k</span>@sys:~&gt; cat Projects/*/README.md</h2>",
    "<div class='grid'><p class='loading'>loading repos</p></div>"
  ],
  "css": [
    ".grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(232px, 1fr)); gap: 16px 8px; }",
    ".grid > .loading, .grid > .msg { grid-column: 1 / -1; }",
    ".proj { display: flex; flex-direction: column; gap: 8px; padding: 8px; border: 1px solid var(--line); }",
    ".proj:hover { border-color: var(--accent); }",
    ".proj h3 { font-size: 16px; color: var(--accent); font-weight: 700; word-break: break-all; }",
    ".proj p { color: var(--dim); }",
    ".proj .top { display: flex; justify-content: space-between; color: var(--dim); }",
    ".proj .lang { color: var(--ok); }",
    ".proj a { margin-top: auto; align-self: flex-start; }",
    ".msg { color: var(--dim); }"
  ],
  "js": [
    "const grid = root.querySelector('.grid');",
    "const user = ctx.site.github;",
    "const count = ctx.config.count || 6;",
    "const KEY = 'usr40k:repos:' + user;",
    "const TTL = (ctx.config.cacheMinutes || 10) * 60000;",
    "",
    "const slim = (r) => ({ name: r.name, description: r.description, language: r.language, updated_at: r.updated_at, html_url: r.html_url, fork: r.fork });",
    "",
    "async function repos() {",
    "  try {",
    "    const c = JSON.parse(sessionStorage.getItem(KEY));",
    "    if (c && Date.now() - c.t < TTL) return c.d;",
    "  } catch (e) { /* no storage */ }",
    "  const r = await fetch('https://api.github.com/users/' + encodeURIComponent(user) + '/repos?sort=updated&per_page=100');",
    "  if (!r.ok) throw new Error('github api ' + r.status);",
    "  const d = (await r.json()).map(slim);",
    "  try { sessionStorage.setItem(KEY, JSON.stringify({ t: Date.now(), d })); } catch (e) { /* ignore */ }",
    "  return d;",
    "}",
    "",
    "const msg = (t) => { grid.textContent = ''; const p = document.createElement('p'); p.className = 'msg'; p.textContent = t; grid.appendChild(p); };",
    "",
    "function card(repo) {",
    "  const a = document.createElement('article');",
    "  a.className = 'proj';",
    "  const top = document.createElement('div');",
    "  top.className = 'top';",
    "  const lang = document.createElement('span');",
    "  lang.className = 'lang';",
    "  lang.textContent = repo.language || 'code';",
    "  const yr = document.createElement('span');",
    "  yr.textContent = repo.updated_at ? new Date(repo.updated_at).getFullYear() : '';",
    "  top.append(lang, yr);",
    "  const h3 = document.createElement('h3');",
    "  h3.textContent = repo.name;",
    "  h3.dataset.ripple = '';",
    "  const p = document.createElement('p');",
    "  p.textContent = repo.description || 'no description provided';",
    "  const link = document.createElement('a');",
    "  link.href = repo.html_url;",
    "  link.target = '_blank';",
    "  link.rel = 'noopener noreferrer';",
    "  link.textContent = 'repo →';",
    "  a.append(top, h3, p, link);",
    "  ctx.ripple(h3);",
    "  return a;",
    "}",
    "",
    "try {",
    "  const all = (await repos())",
    "    .filter((r) => !r.fork)",
    "    .sort((a, b) => new Date(b.updated_at) - new Date(a.updated_at))",
    "    .slice(0, count);",
    "  if (!all.length) { msg('no repos found'); }",
    "  else { grid.textContent = ''; all.forEach((r) => grid.appendChild(card(r))); }",
    "} catch (e) {",
    "  msg('failed to load repos (' + e.message + ')');",
    "}"
  ]
}
