{
  "title": "streams",
  "accent": "#00ffff",
  "min": {
    "w": 200,
    "h": 160
  },
  "config": {
    "followsUrl": "data/follows.json",
    "streamers": [],
    "interval": 6000
  },
  "html": [
    "<div class='ss'>",
    "  <a class='art' target='_blank' rel='noopener noreferrer' aria-label='open channel on twitch'>",
    "    <img alt=''>",
    "    <span class='ph' hidden></span>",
    "  </a>",
    "  <div class='meta'>",
    "    <div><b class='name' data-ripple></b> <span class='state dim'></span></div>",
    "    <div><a class='link' target='_blank' rel='noopener noreferrer'></a></div>",
    "    <div class='ctl'>",
    "      <button type='button' class='prev' aria-label='previous streamer'>&lt;</button>",
    "      <span class='pos dim'></span>",
    "      <button type='button' class='next' aria-label='next streamer'>&gt;</button>",
    "    </div>",
    "  </div>",
    "  <p class='empty dim' hidden>no streamers listed yet.",
    "add logins to config.streamers in tiles/streams.json",
    "or enable the twitch-follows workflow (see README).</p>",
    "</div>"
  ],
  "css": [
    ".tile-body { display: flex; flex-direction: column; }",
    ".ss { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 8px; }",
    ".art { position: relative; flex: 1 1 0; min-height: 48px; display: block; border: 1px solid var(--line); background: var(--bg-alt); overflow: hidden; }",
    ".art:hover, .art:focus-visible { background: var(--bg-alt); color: inherit; border-color: var(--accent); }",
    ".art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }",
    ".art[data-kind='avatar'] img { object-fit: contain; }",
    ".ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 32px; color: var(--line); }",
    ".name { color: var(--accent); }",
    ".meta { display: flex; flex-direction: column; gap: 8px; }",
    ".ctl button { appearance: none; border: 0; background: none; color: var(--accent); cursor: pointer; padding: 0 8px; }",
    ".ctl button::before { content: '['; color: var(--dim); }",
    ".ctl button::after { content: ']'; color: var(--dim); }",
    ".ctl button:hover, .ctl button:focus-visible { background: var(--accent); color: #000; outline: none; }",
    ".ctl button:hover::before, .ctl button:hover::after, .ctl button:focus-visible::before, .ctl button:focus-visible::after { color: #000; }",
    ".empty { white-space: pre-wrap; }",
    ".ss.is-empty .art, .ss.is-empty .meta { display: none; }"
  ],
  "js": [
    "const cfg = ctx.config;",
    "const $ = (s) => root.querySelector(s);",
    "const ss = $('.ss'), art = $('.art'), img = $('.art img'), ph = $('.ph');",
    "const nameEl = $('.name'), stateEl = $('.state'), linkEl = $('.link'), posEl = $('.pos');",
    "const cache = new Map();",
    "let list = [], idx = 0, paused = false, token = 0;",
    "",
    "const norm = (s) => (typeof s === 'string'",
    "  ? { login: s, name: s, avatar: '' }",
    "  : { login: s.login, name: s.name || s.login, avatar: s.avatar || s.profile_image_url || '' });",
    "",
    "async function load() {",
    "  const out = [];",
    "  if (cfg.followsUrl) {",
    "    try {",
    "      const d = await ctx.fetchJSON(cfg.followsUrl);",
    "      (d.streamers || []).forEach((s) => out.push(norm(s)));",
    "    } catch (e) { /* no follows file yet */ }",
    "  }",
    "  (cfg.streamers || []).forEach((s) => out.push(norm(s)));",
    "  const seen = new Set();",
    "  list = out.filter((s) => {",
    "    if (!s.login) return false;",
    "    s.login = s.login.toLowerCase();",
    "    if (seen.has(s.login)) return false;",
    "    seen.add(s.login);",
    "    return true;",
    "  });",
    "}",
    "",
    "// live check: decapi returns '<login> is offline' or an uptime like '2 hours, 3 minutes'",
    "async function status(login) {",
    "  const hit = cache.get(login);",
    "  if (hit && Date.now() - hit.t < 60000) return hit;",
    "  const res = { t: Date.now(), live: null, text: '' };",
    "  try {",
    "    const r = await fetch('https://decapi.me/twitch/uptime/' + encodeURIComponent(login));",
    "    const text = (await r.text()).trim();",
    "    if (/offline/i.test(text)) res.live = false;",
    "    else if (/(second|minute|hour|day)/i.test(text)) { res.live = true; res.text = text; }",
    "  } catch (e) { /* leave unknown */ }",
    "  cache.set(login, res);",
    "  return res;",
    "}",
    "",
    "function setArt(src, kind, s) {",
    "  art.dataset.kind = kind;",
    "  if (src) {",
    "    img.hidden = false;",
    "    img.src = src;",
    "    ph.hidden = true;",
    "  } else {",
    "    img.hidden = true;",
    "    img.removeAttribute('src');",
    "    ph.hidden = false;",
    "    ph.textContent = s.name.slice(0, 2).toUpperCase();",
    "  }",
    "}",
    "",
    "img.addEventListener('error', () => {",
    "  const s = list[idx];",
    "  if (!s) return;",
    "  if (art.dataset.kind === 'preview' && s.avatar) setArt(s.avatar, 'avatar', s);",
    "  else setArt('', 'none', s);",
    "});",
    "",
    "async function show(n) {",
    "  if (!list.length) return;",
    "  idx = (n + list.length) % list.length;",
    "  const s = list[idx];",
    "  const mine = ++token;",
    "  nameEl.textContent = s.name;",
    "  ctx.pulse(nameEl);",
    "  linkEl.textContent = 'twitch.tv/' + s.login;",
    "  linkEl.href = art.href = 'https://twitch.tv/' + s.login;",
    "  posEl.textContent = (idx + 1) + '/' + list.length;",
    "  setArt(s.avatar, 'avatar', s);",
    "  stateEl.className = 'state dim';",
    "  stateEl.textContent = '...';",
    "  const st = await status(s.login);",
    "  if (mine !== token) return;",
    "  if (st.live) {",
    "    stateEl.className = 'state ok';",
    "    stateEl.textContent = '● live ' + st.text;",
    "    setArt('https://static-cdn.jtvnw.net/previews-ttv/live_user_' + s.login + '-640x360.jpg?t=' + Math.floor(Date.now() / 60000), 'preview', s);",
    "  } else if (st.live === false) {",
    "    stateEl.textContent = '○ offline';",
    "  } else {",
    "    stateEl.textContent = '';",
    "  }",
    "}",
    "",
    "$('.prev').addEventListener('click', () => show(idx - 1));",
    "$('.next').addEventListener('click', () => show(idx + 1));",
    "ctx.tile.addEventListener('keydown', (e) => {",
    "  if (e.key === 'ArrowLeft') show(idx - 1);",
    "  if (e.key === 'ArrowRight') show(idx + 1);",
    "});",
    "// hovering or focusing the tile holds the current slide",
    "ctx.tile.addEventListener('pointerenter', () => { paused = true; });",
    "ctx.tile.addEventListener('pointerleave', () => { paused = false; });",
    "ctx.tile.addEventListener('focusin', () => { paused = true; });",
    "ctx.tile.addEventListener('focusout', () => { paused = false; });",
    "",
    "await load();",
    "if (!list.length) {",
    "  ss.classList.add('is-empty');",
    "  $('.empty').hidden = false;",
    "} else {",
    "  show(0);",
    "  ctx.interval(() => { if (!paused && list.length > 1) show(idx + 1); }, cfg.interval || 6000);",
    "}"
  ]
}
