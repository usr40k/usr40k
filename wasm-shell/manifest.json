{
  "name": "usr40k-web-shell",
  "runtime": "wasm",
  "shell": "zsh",
  "framework": "oh-my-zsh",
  "target": "browser",
  "version": "1.0.0",
  "wasm": {
    "module": "shell.wasm",
    "runtime": "shell-runtime.js",
    "memory": "2MiB",
    "compiler": "clang --target=wasm32"
  },
  "files": [
    ".zshrc",
    "oh-my-zsh/README.md",
    "README.md",
    "manifest.json",
    "shell.c",
    "shell.wasm",
    "shell-runtime.js",
    "test-wasm.js"
  ]
}
